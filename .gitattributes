# Git LFS для бинарных ассетов Unreal Engine.
# Крупные бинарники хранятся в LFS, чтобы обычная git-история не распухала.

# --- Ассеты/уровни UE ---
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.ubulk  filter=lfs diff=lfs merge=lfs -text
*.uexp   filter=lfs diff=lfs merge=lfs -text
*.uptnl  filter=lfs diff=lfs merge=lfs -text
*.pak    filter=lfs diff=lfs merge=lfs -text

# --- Изображения/текстуры ---
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.bmp     filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.tif     filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.cubemap filter=lfs diff=lfs merge=lfs -text

# --- Меши/шрифты ---
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.max filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.TTF filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# --- Аудио/видео ---
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# --- Прочее ---
*.pdf filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text

# --- Бинарные, но НЕ в LFS ---
# Скомпилированная локализация UE (~50 КБ на язык): бинарный формат, но мелкий,
# в LFS не отправляем — иначе история файла размажется между LFS и обычными
# объектами. Помечаем binary, чтобы git не нормализовал переводы строк и не
# пытался делать текстовый merge.
*.locres  binary
*.locmeta binary
# .manifest/.archive — UTF-16LE, git видит их как бинарные. Помечаем явно, чтобы
# нормализация CRLF никогда не поломала кодировку исходников перевода.
Content/Localization/**/*.manifest binary
Content/Localization/**/*.archive  binary

# --- Текстовые файлы: под LFS не отправлять ---
# Явная страховка: исходники, конфиги и документация обязаны лежать в git как
# обычный текст — иначе преподаватель без установленного git-lfs получит вместо
# кода и .ini указатели LFS, а diff по истории станет нечитаемым.
*.cpp  !filter !diff !merge
*.h    !filter !diff !merge
*.cs   !filter !diff !merge
*.ini  !filter !diff !merge
*.md   !filter !diff !merge
*.uproject !filter !diff !merge
*.uplugin  !filter !diff !merge
*.ps1  !filter !diff !merge
*.json !filter !diff !merge
